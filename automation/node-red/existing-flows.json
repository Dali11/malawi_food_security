    "func": "const payload = msg.payload;\n\nif (payload?.message?.content) {\n    msg.payload = String(payload.message.content);\n    return msg;\n}\n\nif (payload?.error) {\n    msg.payload = \"Sorry, something went wrong: \" + payload.error;\n    return msg;\n}\n\nnode.warn(\"Unexpected AI response format\");\nreturn null;",

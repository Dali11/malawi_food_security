  {
    "id": "81f45eb0d24c3226",
    "type": "function",
    "z": "46867c076c9b08d5",
    "name": "Prepare AI Request",
    "func": "const prompt = String(msg.payload);\n\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\n\nmsg.payload = {\n    model: \"qwen3:1.7b\",\n    messages: [\n        {\n            role: \"user\",\n            content: prompt\n        }\n    ],\n    think: false,\n    options: {\n        num_predict: 128\n    },\n    stream: false\n};\n\nreturn msg;",

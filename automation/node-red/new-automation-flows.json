  {
    "id": "33af70c2fc5821f7",
    "type": "function",
    "z": "c5e096c624bfd1d1",
    "name": "Validate AI output and prepare report",
    "func": "const e=msg._reportEvidence;const text=msg.payload&&msg.payload.message&&msg.payload.message.content?String(msg.payload.message.content).trim():'';const evidenceNumbers=new Set((JSON.stringify(e).match(/\\d+(?:[.,]\\d+)?/g)||[]).map(v=>v.replace(/,/g,'')));const outputNumbers=(text.match(/\\d+(?:[.,]\\d+)?/g)||[]).map(v=>v.replace(/,/g,''));const grounded=Boolean(text)&&outputNumbers.every(v=>evidenceNumbers.has(v));if(!grounded){msg._fallbackEvidence=e;return [null,msg];}const hex=String(msg._msgid||Date.now().toString(16)).replace(/[^a-f0-9]/ig,'').toLowerCase();let s=(hex+Date.now().toString(16)+'00000000000000000000000000000000').slice(0,32).padEnd(32,'0').split('');s[12]='4';s[16]='a';const id=s.slice(0,8).join('')+'-'+s.slice(8,12).join('')+'-'+s.slice(12,16).join('')+'-'+s.slice(16,20).join('')+'-'+s.slice(20).join('');const base=(env.get('MFS_AUTOMATION_API_BASE')||'').replace(/\\/$/,'');msg.url=base+'/api/automation/weekly-report';msg.headers={Authorization:'Bearer '+(env.get('MFS_AUTOMATION_API_TOKEN')||''),Host:env.get('MFS_AUTOMATION_API_HOST')||'','Content-Type':'application/json'};msg.payload={report_id:id,period_start:e.period_start,period_end:e.period_end,content:text,evidence:e,model:env.get('MFS_REPORT_MODEL')||'qwen3:1.7b'};return [msg,null];",

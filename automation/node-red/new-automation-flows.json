  {
    "id": "9d7c5e81f36944d4",
    "type": "function",
    "z": "c5e096c624bfd1d1",
    "name": "Build deterministic report from observed values",
    "func": "const e=msg._fallbackEvidence||msg._reportEvidence;if(!e)throw new Error('Report evidence unavailable; failure recorded separately');const fmt=v=>v===null||v===undefined?'unavailable':String(v);const rows=(a,fn)=>Array.isArray(a)&&a.length?a.slice(0,8).map(fn).join('; '):'No observations recorded for this period.';const content=['Weekly food price situation report: '+e.period_start+' to '+e.period_end+'.','Data through: '+fmt(e.data_through)+'.','District instability (mean absolute observed price change): '+rows(e.district_instability,r=>r.district+': '+fmt(r.mean_abs_pct_change)+'% across '+fmt(r.observations)+' observations).','Commodity price changes (observed mean): '+rows(e.commodity_increases,r=>r.commodity+': '+fmt(r.mean_pct_change)+'% across '+fmt(r.observations)+' observations).','Severe and critical spike counts: '+rows(e.severe_critical_spike_counts,r=>r.severity+': '+fmt(r.event_count))+'.','Recent severe/critical event examples: '+rows(e.severe_critical_spikes,r=>r.event_date+' \u00b7 '+r.district+' \u00b7 '+r.commodity+' \u00b7 '+r.severity+' \u00b7 '+fmt(r.pct_change)+'%).','Emerging monitoring hotspots (top-five instability and top-ten risk overlap): '+(e.emerging_hotspots&&e.emerging_hotspots.length?e.emerging_hotspots.join(', '):'No overlap identified from available evidence.')+'.','District risk score changes: '+rows(e.district_risk_changes,r=>r.district+': '+fmt(r.risk_score)+' (change '+fmt(r.risk_score_change)+')')+'.','Weekly versus prior-week average prices: '+rows(e.historical_price_comparison,r=>r.commodity+': '+fmt(r.current_week_avg)+' versus '+fmt(r.prior_week_avg))+'.','Price movements are descriptive; the supplied data do not establish causation.'].join('\\n');const hex=String(msg._msgid||Date.now().toString(16)).replace(/[^a-f0-9]/ig,'').toLowerCase();let s=(hex+Date.now().toString(16)+'00000000000000000000000000000000').slice(0,32).padEnd(32,'0').split('');s[12]='4';s[16]='a';const id=s.slice(0,8).join('')+'-'+s.slice(8,12).join('')+'-'+s.slice(12,16).join('')+'-'+s.slice(16,20).join('')+'-'+s.slice(20).join('');const base=(env.get('MFS_AUTOMATION_API_BASE')||'').replace(/\\/$/,'');msg._workflowName='weekly-situation-report';msg.url=base+'/api/automation/weekly-report';msg.headers={Authorization:'Bearer '+(env.get('MFS_AUTOMATION_API_TOKEN')||''),Host:env.get('MFS_AUTOMATION_API_HOST')||'','Content-Type':'application/json'};msg.payload={report_id:id,period_start:e.period_start,period_end:e.period_end,content, evidence:e,model:'evidence-only-fallback'};return msg;",

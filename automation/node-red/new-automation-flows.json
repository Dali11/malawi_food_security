    "name": "Retry transient errors safely (same idempotency key)",
    "func": "const base=(env.get('MFS_AUTOMATION_API_BASE')||'').replace(/\\/$/,'');const token=env.get('MFS_AUTOMATION_API_TOKEN')||'';const host=env.get('MFS_AUTOMATION_API_HOST')||'';const code=Number(msg.statusCode||0);const retryable=Boolean(msg.error)||(code>=500&&code!==502)||code===0;const tries=Number(msg._pipelineRetry||0);if(retryable&&tries<2){msg._pipelineRetry=tries+1;msg.payload=msg._pipelineRequest;msg.url=base+'/api/automation/pipeline/run';msg.headers={Authorization:'Bearer '+token,Host:host,'Content-Type':'application/json'};delete msg.statusCode;delete msg.error;return [null,msg];}const why=msg.error&&msg.error.message?msg.error.message:(msg.payload&&msg.payload.detail?msg.payload.detail:'HTTP '+(code||'request failed'));msg.url=base+'/api/automation/workflow-failure';msg.headers={Authorization:'Bearer '+token,Host:host,'Content-Type':'application/json'};msg.payload={workflow_name:'wfp-price-update',message:('Pipeline run did not complete after '+(tries+1)+' attempt(s): '+String(why)).slice(0,900)};return [msg,null];",

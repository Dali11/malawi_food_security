    "name": "Request the existing Python pipeline",
    "func": "function uuid(source){let s=String(source||Date.now().toString(16)).replace(/[^a-f0-9]/ig,'').toLowerCase();s=(s+Date.now().toString(16)+'00000000000000000000000000000000').slice(0,32).padEnd(32,'0').split('');s[12]='4';s[16]='a';return s.slice(0,8).join('')+'-'+s.slice(8,12).join('')+'-'+s.slice(12,16).join('')+'-'+s.slice(16,20).join('')+'-'+s.slice(20).join('');}const base=(env.get('MFS_AUTOMATION_API_BASE')||'').replace(/\\/$/,'');const token=env.get('MFS_AUTOMATION_API_TOKEN')||'';const host=env.get('MFS_AUTOMATION_API_HOST')||'';msg._workflowName='wfp-price-update';msg._pipelineRequest={request_id:uuid(msg._msgid),trigger:'node-red-schedule'};msg._pipelineRetry=0;msg.url=base+'/api/automation/pipeline/run';msg.headers={Authorization:'Bearer '+token,Host:host,'Content-Type':'application/json'};msg.payload=msg._pipelineRequest;return msg;",

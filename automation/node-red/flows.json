    "name": "Ask local Ollama to explain evidence only",
    "func": "if(Number(msg.statusCode||0)>=400)throw new Error('Weekly evidence endpoint returned HTTP '+msg.statusCode);const e=msg.payload;if(!e||!e.period_start||!e.period_end)throw new Error('Weekly evidence response was incomplete');msg._reportEvidence=e;msg._workflowName='weekly-situation-report';msg.url=env.get('MFS_OLLAMA_URL')||'http://10.0.0.1:11434/api/chat';msg.headers={'Content-Type':'application/json'};msg.payload={model:env.get('MFS_REPORT_MODEL')||'qwen3:1.7b',stream:false,messages:[{role:'system',content:'You are an evidence-grounded Malawi food price analyst. Explain only patterns explicitly supported by the supplied JSON. Do not invent statistics, dates, districts, commodities, or events. Do not claim causes or causation. If historical or risk-score comparisons are unavailable, say so. Distinguish price instability from food insecurity and describe hotspot names only as a descriptive overlap. Keep the report concise and cite the supplied values exactly.'},{role:'user',content:'Write a weekly situation report using only this evidence JSON:\n'+JSON.stringify(e)}]};return msg;",
